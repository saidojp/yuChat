# ---------------------------------------------------------------------------
# YuChat environment template. Copy to backend/.env (or export in your shell)
# and fill in real values. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Render PostgreSQL. Two accepted forms:
#   1. The "External Database URL": postgres://user:pass@host:5432/dbname
#      (the backend converts it to an Npgsql connection string automatically)
#   2. A classic Npgsql string:
#      Host=host;Port=5432;Database=dbname;Username=user;Password=pass;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection="postgres://USER:PASSWORD@HOST:5432/DATABASE"

# JWT signing key: at least 32 bytes. Generate with:
#   openssl rand -hex 32
Jwt__Key="CHANGE_ME_at_least_32_bytes_long_random_string"

# AES-256 master key: exactly 32 random bytes, Base64-encoded. Generate with:
#   openssl rand -base64 32
# Losing this key makes existing messages permanently unreadable.
Encryption__MasterKey="CHANGE_ME_base64_32_bytes"

# Optional: previous keys kept readable after rotation (version -> base64 key)
# Encryption__KeyRing__1="OLD_BASE64_32_BYTES"

# Origin allowed by CORS (Vite dev server by default)
Frontend__Origin="http://localhost:5173"

# Store the refresh token in an httpOnly cookie (recommended) instead of a header
Frontend__UseRefreshCookie="true"
