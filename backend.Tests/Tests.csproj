    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../backend/backend.csproj" />
  </ItemGroup>

</Project>
